#!/usr/bin/env bash
# Pre-commit guardrails — blocks secrets and direct commits to main/master.
# Install: make install-hooks
# DO NOT bypass with --no-verify. If this blocks a legitimate commit, fix the root cause.

set -euo pipefail

FAIL=0

# ── 1. Branch protection ──────────────────────────────────────────────────────
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
    echo "BLOCKED: direct commits to '$BRANCH' are not allowed." >&2
    echo "         Create a feature branch: git checkout -b feat/your-change" >&2
    FAIL=1
fi

# ── 2. Secret scanning ────────────────────────────────────────────────────────
# Add new patterns here as new secret types are introduced.
SECRET_PATTERNS=(
    'opbr_[A-Za-z0-9_-]{20,}'   # OpenBrain bearer tokens
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

for file in $STAGED_FILES; do
    [[ -f "$file" ]] || continue
    # Skip binary files
    if file "$file" 2>/dev/null | grep -qiE "binary|image|PDF|Zip|compiled"; then
        continue
    fi
    staged_content=$(git show ":$file" 2>/dev/null) || continue
    for pattern in "${SECRET_PATTERNS[@]}"; do
        if echo "$staged_content" | grep -qE "$pattern"; then
            echo "BLOCKED: possible secret in '$file' (pattern: $pattern)" >&2
            echo "         Use a placeholder like YOUR_TOKEN_HERE instead." >&2
            FAIL=1
        fi
    done
done

# ── 3. Schema-change dependency gate (ADR-020) ────────────────────────────────
# A migration that DROPs/RENAMEs/retypes a column (or DROPs a table) can orphan a
# trigger/function whose PL/pgSQL body still reads it — Postgres records no catalog
# dependency for that, so the drop succeeds and fails SILENTLY at the next write (the
# 2026-08-06 incident: 6 days of ingests invisible to search). This is the belt to the
# PM reviewer's braces: block such a migration unless a preflight artifact is committed
# alongside it. Convention: <migration>.sql needs a co-committed <migration>.preflight.txt
# — produce it with:  python scripts/preflight_migration.py <table> | tee <migration>.preflight.txt
# Static + offline-safe by design: at commit time the migration is NOT yet applied, so a
# live scan would check stale state; the artifact is the reviewable evidence the author ran it.
DDL_RE='(DROP[[:space:]]+COLUMN|RENAME[[:space:]]+COLUMN|ALTER[[:space:]]+COLUMN[[:space:]].+TYPE|DROP[[:space:]]+TABLE)'
for file in $STAGED_FILES; do
    case "$file" in
        supabase/migrations/*.sql) ;;
        *) continue ;;
    esac
    # Ignore full-line SQL comments so a DROP COLUMN in a rollback note doesn't false-trip.
    body=$(git show ":$file" 2>/dev/null | grep -vE '^[[:space:]]*--' || true)
    if echo "$body" | grep -qiE "$DDL_RE"; then
        artifact="${file%.sql}.preflight.txt"
        if echo "$STAGED_FILES" | grep -qxF "$artifact"; then
            continue
        fi
        echo "BLOCKED: '$file' drops/renames a column or table but no preflight artifact" >&2
        echo "         is committed (ADR-020). Trigger/function bodies that read a dropped" >&2
        echo "         column break SILENTLY — Postgres won't stop you." >&2
        echo "         Run:  python scripts/preflight_migration.py <table> | tee $artifact" >&2
        echo "         then 'git add $artifact' and commit both." >&2
        FAIL=1
    fi
done

# ── Result ────────────────────────────────────────────────────────────────────
if [[ $FAIL -ne 0 ]]; then
    echo "" >&2
    echo "Commit aborted. --no-verify is not an acceptable workaround." >&2
    exit 1
fi

exit 0
