{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/session_report",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/supersession_reconcile",
      "schedule": "0 4 * * *"
    }
  ],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/openbrain_(query|generate_quiz|generate_flashcards|ingest|plan_ingest)(/)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/tools/openbrain_(query|generate_quiz|generate_flashcards|ingest|plan_ingest)(/)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/claude_(query|generate_quiz|generate_flashcards|ingest|plan_ingest)(/)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/tools/claude_(query|generate_quiz|generate_flashcards|ingest|plan_ingest)(/)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/(query|search|generate_quiz|generate_flashcards|ingest|plan_ingest|session_report)(/)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/mcp/messages(/)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/.well-known/oauth-authorization-server",
      "dest": "/api/index.py"
    },
    {
      "src": "/authorize(/)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/token(/)?",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
